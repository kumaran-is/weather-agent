# ============================================================================
# Docker Ignore File - Weather AI Agent Service
# ============================================================================
# Excludes files/directories from Docker build context to:
#   - Reduce image size
#   - Speed up builds
#   - Prevent sensitive data leakage
# ============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Documentation (but keep README.md for pyproject.toml)
docs/

# Environment files (CRITICAL - Never include in image)
.env
.env.*
!.env.template

# Logs
*.log
logs/

# Docker
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# CI/CD
.github/
.gitlab-ci.yml

# Verification scripts (Level 0 only)
verify_setup.py

# Temporary files
tmp/
temp/
*.tmp
