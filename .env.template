# ============================================================================
# Weather AI Agent Service - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME="Weather AI Agent Service"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # Options: development, staging, production
DEBUG=true
LOG_LEVEL="INFO"  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# API SERVER SETTINGS
# ============================================================================
HOST="0.0.0.0"
PORT=8000
RELOAD=true
WORKERS=1

# ============================================================================
# LLM API KEYS (REQUIRED)
# ============================================================================
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Anthropic API key (optional, for future use)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# ============================================================================
# LLM MODEL CONFIGURATION
# ============================================================================
PRIMARY_MODEL="gpt-4o-mini"
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================
# HTTP transport via Docker on port 8080
# Weather MCP Serve
MCP_WEATHER_SERVER_URL="http://localhost:8080"
MCP_WEATHER_SERVER_ENABLED=true
MCP_WEATHER_HEALTH_CHECK_TIMEOUT=500
MCP_WEATHER_MAX_RETRIES=3
MCP_WEATHER_RETRY_DELAY=1000

# Hurricane Tracker MCP Server
MCP_HURRICANE_SERVER_URL="http://localhost:8081"
MCP_HURRICANE_SERVER_ENABLED=true

# ============================================================================
# DATABASE CONFIGURATION (for future levels)
# ============================================================================
POSTGRES_URL="postgresql://localhost:5432/weather_ai"
REDIS_URL="redis://localhost:6379/0"
QDRANT_URL="http://localhost:6333"

# ============================================================================
# LANGSMITH CONFIGURATION (Observability - Optional)
# ============================================================================
# Get your LangSmith API key from: https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="weather-agent"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS="*"  # Restrict in production: ["https://yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# CRITICAL: Change this in production! Use a strong random string
SECRET_KEY="development-secret-key-change-in-production"
API_KEY_HEADER="X-API-Key"

# ============================================================================
# RATE LIMITING (Level 5c+)
# ============================================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
