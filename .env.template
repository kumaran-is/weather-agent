# ============================================================================
# Weather AI Agent Service - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)
# This template includes ALL environment variables that are loaded by configuration classes under:
# - `backend/config/*.py` 
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME="Weather AI Agent Service"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development | staging | production
DEBUG=true
LOG_LEVEL="INFO"  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ============================================================================
# API SERVER SETTINGS
# ============================================================================
HOST="0.0.0.0"
PORT=8000
RELOAD=true
WORKERS=1

# ============================================================================
# LLM API KEYS (REQUIRED)
# ============================================================================
# Get your OpenAI API key from: https://platform.openai.com/api-keys
# OpenAI API key (REQUIRED - minimum 20 characters)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API key (optional, for future use)
# Get from: https://console.anthropic.com/settings/keys
# Anthropic API key (OPTIONAL - for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ========================================
# LLM MODEL CONFIGURATION
# ========================================
# Primary model for agent execution
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo, claude-3-5-sonnet-20241022
PRIMARY_MODEL=gpt-4o-mini
# Model temperature (0.0 = deterministic, 1.0 = creative)
MODEL_TEMPERATURE=0.7
# Max tokens for model responses
MODEL_MAX_TOKENS=4096
# Model timeout in seconds
MODEL_TIMEOUT=120

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================
# HTTP transport via Docker on port 8080
# Weather MCP Serve
MCP_WEATHER_SERVER_URL="http://localhost:8080"
MCP_WEATHER_SERVER_ENABLED=true
MCP_WEATHER_HEALTH_CHECK_TIMEOUT=500
MCP_WEATHER_MAX_RETRIES=3
MCP_WEATHER_RETRY_DELAY=1000

# Hurricane Tracker MCP Server
MCP_HURRICANE_SERVER_URL="http://localhost:8081"
MCP_HURRICANE_SERVER_ENABLED=true

# MCP request timeout (seconds)
MCP_REQUEST_TIMEOUT=30
# Enable MCP failover to direct API calls if MCP server is down
MCP_ENABLE_FAILOVER=true

# ============================================================================
# LANGSMITH TRACING & OBSERVABILITY
# ============================================================================
# Enable LangSmith tracing (true for development, false for production)
LANGCHAIN_TRACING_V2=true
# LangSmith API key (get fromhttps://smith.langchain.com/settings)
LANGCHAIN_API_KEY=your-langsmith-api-key-here
# LangSmith project name (helps organize traces)
LANGCHAIN_PROJECT="weather-ai-agent-service"
# LangSmith endpoint (default: https://api.smith.langchain.com)
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# ========================================
# CORS CONFIGURATION
# ========================================
# Allowed CORS origins (comma-separated, * for all)
# Development: "*" | Production: "https://yourdomain.com,https://app.yourdomain.com"
CORS_ORIGINS=*
# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=true
# Allowed HTTP methods
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
# Allowed headers
CORS_ALLOW_HEADERS=*

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# CRITICAL: Change this in production! Use a strong random string
# Secret key for JWT tokens and encryption (CHANGE IN PRODUCTION!)
SECRET_KEY="development-secret-key-change-in-production"
API_KEY_HEADER="X-API-Key"
# JWT token expiration (seconds, default: 24 hours)
JWT_EXPIRATION_SECONDS=86400
# Enable API key authentication
ENABLE_API_KEY_AUTH=false
# API key (if ENABLE_API_KEY_AUTH=true)
API_KEY=
# Enable rate limiting
ENABLE_RATE_LIMITING=false
# Rate limit: max requests per minute
RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# RATE LIMITING (Level 5c+)
# ============================================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100

# ============================================================================
# Agent Feature Flags
# ============================================================================
#Enable Retrieval-Augmented Generation (RAG)
ENABLE_RAG=true
# Enable Chain-of-Thought (CoT) reasoning
ENABLE_COT=false
# Enable Tree-of-Thoughts (ToT) reasoning (Level 3b)
ENABLE_TOT=false
# Enable Graph-of-Thoughts (GoT) reasoning (Level 3b)
ENABLE_GOT=false
# Enable multi-agent orchestration (Level 4+)
ENABLE_MULTI_AGENT=false

# ========================================
# HYBRID SEARCH CONFIGURATION
# ========================================
# Vector search weight (0.0 to 1.0)
HYBRID_SEARCH_VECTOR_WEIGHT=0.7
# BM25 keyword search weight (0.0 to 1.0)
HYBRID_SEARCH_BM25_WEIGHT=0.3
# Minimum similarity score for retrieval (0.0 to 1.0)
HYBRID_SEARCH_MIN_SCORE=0.5
# Number of documents to retrieve
HYBRID_SEARCH_TOP_K=5


# ============================================================================
# DATABASE CONFIGURATION 
# ============================================================================
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
POSTGRES_URL=postgresql://weather_ai:weatherai2025@localhost:5432/weather_ai

# ============================================================================
# REDIS CONFIGURATION (Short-term Memory + cache)
# ============================================================================
REDIS_URL="redis://localhost:6379/0"
# Redis TTL for conversation history (seconds, default: 30 min)
REDIS_TTL_SECONDS=1800
# Max conversation turns to keep in Redis (default: 10)
REDIS_MAX_CONVERSATION_TURNS=10
# Max Redis connections (connection pool size)
REDIS_MAX_CONNECTIONS=50

# ============================================================================
# VECTOR DATABASE CONFIGURATION (KB + Long-term Memory)
# ============================================================================
QDRANT_URL="http://localhost:6333"
# Qdrant API key (OPTIONAL - for Qdrant Cloud)
QDRANT_API_KEY=
# Qdrant collection name
QDRANT_COLLECTION_NAME=weather_knowledge

# ============================================================================
# GRAPH DATABASE CONFIGURATION (Long-term Memory)
# ============================================================================
# Neo4j Bolt URL for Graphiti
GRAPHITI_URL=bolt://localhost:7687
# Neo4j username
GRAPHITI_USER=neo4j
# Neo4j password
GRAPHITI_PASSWORD=weatherai2025
# Neo4j database name
GRAPHITI_DATABASE=weather_ai

# ============================================================================
# MEMORY SYSTEM CONFIGURATION (Level 3a+)
# ============================================================================
# Global memory toggle
ENABLE_MEMORY=true
# Enable entity tracking (tracks users, locations, preferences)
ENABLE_ENTITY_TRACKING=true
# Enable pronoun resolution ("it", "he", "she" → entity names)
ENABLE_PRONOUN_RESOLUTION=true
# Enable user profile building (long-term preferences)
ENABLE_USER_PROFILES=true

# ============================================================================
# MEMORY PERFORMANCE TUNING
# ============================================================================
# Memory context window size (number of recent turns to include)
MEMORY_CONTEXT_WINDOW_SIZE=10
# Memory token budget (max tokens for memory context)
MEMORY_TOKEN_BUDGET=1000
# Enable parallel retrieval from memory layers
MEMORY_PARALLEL_RETRIEVAL=true
# Timeout for memory layer retrieval (seconds)
MEMORY_LAYER_TIMEOUT=5.0
# Enable semantic memory (facts, knowledge)
ENABLE_SEMANTIC_MEMORY=false
# Enable procedural memory (learned workflows)
ENABLE_PROCEDURAL_MEMORY=false
# Enable emotional memory (sentiment tracking)
ENABLE_EMOTIONAL_MEMORY=false
# Enable reflective memory (meta-cognition)
ENABLE_REFLECTIVE_MEMORY=false

# ============================================================================
# CACHING CONFIGURATION (60-75% Cost Reduction)
# ============================================================================
# 3-layer caching system:
# - L1: In-process LRU cache (<1ms, 15-25% hit rate)
# - L2: Redis distributed cache (<10ms, 30-40% hit rate)
# - L3: Anthropic prompt cache (transparent, 60-70% hit rate)

# Global cache toggle
CACHE_ENABLED=true

# --- L1: In-Process LRU Cache ---
# Enable L1 in-process memory cache
L1_CACHE_ENABLED=true
# Max cache entries (1000 = ~2MB memory per server)
L1_CACHE_MAX_SIZE=1000
# Cache entry TTL in seconds (5 minutes)
L1_CACHE_TTL_SECONDS=300

# --- L2: Redis Distributed Cache ---
# Enable L2 Redis distributed cache
L2_CACHE_ENABLED=true
# Redis URL for L2 cache (reuses REDIS_URL or separate instance)
L2_CACHE_REDIS_URL=redis://localhost:6379/0
# Cache entry TTL in seconds (30 minutes)
L2_CACHE_TTL_SECONDS=1800
# Redis key prefix for cache entries
L2_CACHE_KEY_PREFIX=weather:cache:

# --- L3: Anthropic Prompt Cache ---
# Enable L3 Anthropic prompt caching (transparent, 90% cost savings on reads)
L3_CACHE_ENABLED=true
# Number of recent conversation turns to cache (0 = only system/tools)
# Warning: Caching message history can cause stale responses
L3_CACHE_RECENT_TURNS=0

# ============================================================================
# PRODUCTION OPTIMIZATION
# ============================================================================
# Enable query result caching (uses L1+L2+L3)
ENABLE_QUERY_CACHING=true
# Enable response streaming (for real-time output)
ENABLE_STREAMING=false
# Enable request batching (for multi-query optimization)
ENABLE_BATCHING=false
# Batch size (number of queries to batch)
BATCH_SIZE=10
# Batch timeout (seconds)
BATCH_TIMEOUT_SECONDS=5

# ============================================================================
# MONITORING & ALERTING
# ============================================================================
# Enable Prometheus metrics endpoint
ENABLE_PROMETHEUS=false
# Prometheus metrics port
PROMETHEUS_PORT=9090
# Enable health check endpoint
ENABLE_HEALTH_CHECK=true
# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60
# Enable alert notifications
ENABLE_ALERTS=false
# Alert webhook URL (Slack, PagerDuty, etc.)
ALERT_WEBHOOK_URL=

# ========================================
# TESTING & DEVELOPMENT
# ========================================
# Enable test mode (uses mocked LLM responses)
TEST_MODE=false
# Enable debug logging for specific modules (comma-separated)
# Example: "agent,memory,cache"
DEBUG_MODULES=
# Enable SQL query logging
LOG_SQL_QUERIES=false
# Enable performance profiling
ENABLE_PROFILING=false
