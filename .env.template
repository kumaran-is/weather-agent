# ================================================================
# Weather AI Agent Service - Environment Configuration Template
# ================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ================================================================
# OpenAI API Configuration
# ================================================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...your-key-here...

# ================================================================
# Anthropic API Configuration (Optional for Level 1)
# ================================================================
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# ================================================================
# LangSmith Configuration (Tracing & Debugging)
# ================================================================
# Get from: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...your-key-here...
LANGCHAIN_PROJECT=weather-ai-agent-service
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ================================================================
# MCP Server Configuration (DUAL SERVERS - Docker + HTTP)
# ================================================================
# Weather MCP Server (HTTP transport via Docker on port 8080)
# Status: ✅ WORKING (ESM compatibility fixes applied)
MCP_WEATHER_SERVER_URL=http://localhost:8080
MCP_WEATHER_SERVER_ENABLED=true

# Hurricane Tracker MCP Server (HTTP transport via Docker on port 8081)
# Status: ✅ WORKING (healthy)
MCP_HURRICANE_SERVER_URL=http://localhost:8081
MCP_HURRICANE_SERVER_ENABLED=true

# ================================================================
# Application Configuration
# ================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# ================================================================
# Database Configuration (For future levels)
# ================================================================
# Redis (Level 3a - Memory)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# PostgreSQL (Level 5a - RAG)
POSTGRES_URL=postgresql://localhost:5432/weather_ai
POSTGRES_ENABLED=false

# ================================================================
# Security Configuration
# ================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ================================================================
# Monitoring & Observability (Level 5c)
# ================================================================
# Sentry (Error tracking)
SENTRY_DSN=
SENTRY_ENABLED=false

# Prometheus (Metrics)
PROMETHEUS_PORT=9090
PROMETHEUS_ENABLED=false
